# ─────────────────────────────────────────────────────────────────────────────
# testflo — Test environment configuration
#
# USAGE:
#   1. cp .env.test.example .env.test
#   2. Fill in SUPABASE_SERVICE_ROLE_KEY (see note below)
#   3. Run: node tests/seed.js
#
# .env.test is in .gitignore — NEVER commit it.
# .env.test.example is safe to commit — it contains no real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase project ──────────────────────────────────────────────────────────

SUPABASE_URL=https://toxgihdyfzdymgidgvaq.supabase.co

# Anon key (already public — present in frontend source)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InRveGdpaGR5ZnpkeW1naWRndmFxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzY2ODQ0OTYsImV4cCI6MjA5MjI2MDQ5Nn0.FOA3ZA8Eh-g231al2DS4NjGfLjIkpRlmb7_fKXz65Xo

# ⚠  Service role key — NEVER commit the real value
# Get it from: Supabase Dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Test credentials ──────────────────────────────────────────────────────────
# These map to real auth accounts created by seed.js.
# Passwords must match what seed.js uses — if you change them here,
# change them in seed.js too and re-run: node tests/seed.js

TEST_SUPERADMIN_EMAIL=superadmin@test-flo.com
TEST_SUPERADMIN_PASSWORD=TestSuperAdmin123!

TEST_ADMIN_EMAIL=admin@test-flo.com
TEST_ADMIN_PASSWORD=TestAdmin123!

TEST_TEACHER_EMAIL=teacher@test-flo.com
TEST_TEACHER_PASSWORD=TestTeacher123!

# Student uses the exam engine (no dashboard login needed)
TEST_STUDENT_EMAIL=student@test-flo.com
TEST_STUDENT_PASSWORD=TestStudent123!

# ── Local dev server ──────────────────────────────────────────────────────────
# Must be running before Playwright tests execute.
# Start with: npx serve . -p 3000   (or your preferred static server)
BASE_URL=http://localhost:3000

# ── Fixed test data IDs ───────────────────────────────────────────────────────
